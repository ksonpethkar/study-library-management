rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return request.auth.token.email;
    }

    function isMasterAdmin() {
      return isAuth() && (
        email() in ['ksonpethkar@gmail.com', 'thecozycornersc@gmail.com'] ||
        (exists(/databases/$(database)/documents/admin_whitelist/$(email())) &&
         get(/databases/$(database)/documents/admin_whitelist/$(email())).data.get('isActive', false) == true)
      );
    }

    // Owner = person who created the library OR a verified master admin
    function isOwner(libraryId) {
      return isAuth() && (
        isMasterAdmin() ||
        (resource != null && resource.data.get('ownerId', '') == uid()) ||
        (exists(/databases/$(database)/documents/libraries/$(libraryId)) &&
         get(/databases/$(database)/documents/libraries/$(libraryId)).data.get('ownerId', '') == uid())
      );
    }

    // Staff helper — checks the staff sub-collection for a specific permission
    function getStaff(libraryId) {
      return get(/databases/$(database)/documents/libraries/$(libraryId)/staff/$(uid()));
    }

    function isActiveStaff(libraryId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/libraries/$(libraryId)/staff/$(uid())) &&
        getStaff(libraryId).data.get('isActive', true) == true;
    }

    function staffCan(libraryId, permission) {
      return isActiveStaff(libraryId) &&
        getStaff(libraryId).data.get(permission, false) == true;
    }

    // Owner OR staff with specific permission
    function ownerOrStaffCan(libraryId, permission) {
      return isOwner(libraryId) || staffCan(libraryId, permission);
    }

    // ── Libraries ────────────────────────────────────────────────────────────
    match /libraries/{libraryId} {
      // Public read for student web portal / seat map (library name, logo, hours)
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(libraryId) || staffCan(libraryId, 'canManageSettings');
      allow delete: if isOwner(libraryId);

      // ── Seats (direct subcollection) ──────────────────────────────────────
      match /seats/{seatId} {
        allow read: if true;
        allow write: if ownerOrStaffCan(libraryId, 'canManageSeats');
      }

      // ── Sections & Seats (seat map) ─────────────────────────────────────
      match /sections/{sectionId} {
        allow read: if true;
        allow write: if ownerOrStaffCan(libraryId, 'canManageSeats');

        match /seats/{seatId} {
          allow read: if true;
          allow write: if ownerOrStaffCan(libraryId, 'canManageSeats');
        }
      }

      // ── Plans ────────────────────────────────────────────────────────────
      match /plans/{planId} {
        allow read: if true;
        allow write: if ownerOrStaffCan(libraryId, 'canManageStudents');
      }

      // ── Students — PRIVATE ───────────────────────────────────────────────
      match /students/{studentId} {
        allow read: if isOwner(libraryId) ||
                       staffCan(libraryId, 'canManageStudents') ||
                       (isAuth() && (
                         studentId == uid() ||
                         resource.data.get('userId', '') == uid() ||
                         resource.data.get('studentUserId', '') == uid() ||
                         (resource.data.get('email', '') != '' && request.auth.token.email != null &&
                          resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
                         (request.auth.token.phone_number != null &&
                          (resource.data.get('phone', '') == request.auth.token.phone_number ||
                           ('+91' + resource.data.get('phone', '')) == request.auth.token.phone_number ||
                           resource.data.get('phone', '') == ('+91' + request.auth.token.phone_number)))
                       ));

        allow create: if ownerOrStaffCan(libraryId, 'canManageStudents');

        allow update: if isOwner(libraryId) ||
                         staffCan(libraryId, 'canManageStudents') ||
                         (isAuth() && (
                           studentId == uid() ||
                           resource.data.get('userId', '') == uid() ||
                           resource.data.get('studentUserId', '') == uid() ||
                           (resource.data.get('userId', '') == '' && (
                             request.resource.data.get('userId', '') == uid() ||
                             request.resource.data.get('studentUserId', '') == uid()
                           )) ||
                           (resource.data.get('studentUserId', '') == '' && (
                             request.resource.data.get('userId', '') == uid() ||
                             request.resource.data.get('studentUserId', '') == uid()
                           )) ||
                           (resource.data.get('email', '') != '' && request.auth.token.email != null &&
                            resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
                           (request.auth.token.phone_number != null &&
                            (resource.data.get('phone', '') == request.auth.token.phone_number ||
                             ('+91' + resource.data.get('phone', '')) == request.auth.token.phone_number ||
                             resource.data.get('phone', '') == ('+91' + request.auth.token.phone_number)))
                         ) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'fcmToken', 'fcmUpdatedAt', 'photoUrl', 'updatedAt', 'phone', 'email', 'emergencyContact', 'address', 'userId', 'studentUserId',
                            'pinHash', 'biometricEnabled', 'pinUpdatedAt', 'pinResetByAdmin', 'pinResetMessage'
                          ]) &&
                          // SEC-S2: Ensure student cannot set sensitive membership/financial fields
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'membershipStatus', 'planStartDate', 'planEndDate', 'planId',
                            'walletBalance', 'seatId', 'seatLabel', 'govIdNumber',
                            'govIdType', 'govIdImageUrl', 'isDeleted'
                          ]));

        allow delete: if isOwner(libraryId) || staffCan(libraryId, 'canDeleteStudents');

        match /{sub}/{subId} {
          allow read, write: if ownerOrStaffCan(libraryId, 'canManageStudents');
        }
      }

      // ── Payments ─────────────────────────────────────────────────────────
      match /payments/{paymentId} {
        // Students can read their OWN payment records via studentUserId field
        allow read: if isOwner(libraryId) ||
                       staffCan(libraryId, 'canRecordPayments') ||
                       staffCan(libraryId, 'canViewRevenue') ||
                       (isAuth() && uid() == resource.data.get('studentUserId', ''));

        // SERVER-SIDE VALIDATION (ARCH-4):
        // - amount: positive number, max ₹10,00,000
        // - studentId: must be a non-empty string (can't write orphan payments)
        // - paymentMethod / method: must be a non-empty string
        allow create: if ownerOrStaffCan(libraryId, 'canRecordPayments') &&
                         request.resource.data.amount is number &&
                         request.resource.data.amount > 0 &&
                         request.resource.data.amount < 1000000 &&
                         request.resource.data.studentId is string &&
                         request.resource.data.studentId.size() > 0 &&
                         ((request.resource.data.get('paymentMethod', '') is string && request.resource.data.get('paymentMethod', '').size() > 0) ||
                          (request.resource.data.get('method', '') is string && request.resource.data.get('method', '').size() > 0));

        allow update: if ownerOrStaffCan(libraryId, 'canRecordPayments') &&
                         request.resource.data.amount is number &&
                         request.resource.data.amount > 0 &&
                         request.resource.data.amount < 1000000;

        allow delete: if isOwner(libraryId);
      }

      // ── Receipts ─────────────────────────────────────────────────────────
      match /receipts/{receiptId} {
        // Students can only read THEIR OWN receipts; staff/owner see all
        allow read: if isOwner(libraryId) ||
                       staffCan(libraryId, 'canRecordPayments') ||
                       staffCan(libraryId, 'canViewRevenue') ||
                       (isAuth() && uid() == resource.data.get('studentUserId', ''));

        // SEC-R1: Only owner/staff can create receipts (prevents payment bypass)
        allow create: if ownerOrStaffCan(libraryId, 'canRecordPayments') &&
                         request.resource.data.amount is number &&
                         request.resource.data.amount > 0 &&
                         request.resource.data.studentId is string &&
                         request.resource.data.studentId.size() > 0;

        allow update: if ownerOrStaffCan(libraryId, 'canRecordPayments') &&
                         request.resource.data.amount is number &&
                         request.resource.data.amount > 0;

        allow delete: if isOwner(libraryId);
      }

      // ── Metadata (counters, sync tokens) ──────────────────────────────────
      // SEC-H2 FIX: Students can read metadata but only owner/staff can write
      // (prevents counter manipulation by students)
      match /metadata/{docId} {
        allow read: if isAuth();
        allow write: if isOwner(libraryId) || isActiveStaff(libraryId);
      }

      // ── Revenue / Financial reports ───────────────────────────────────────
      match /revenue/{docId} {
        allow read: if isOwner(libraryId) || staffCan(libraryId, 'canViewRevenue');
        allow write: if isOwner(libraryId);
      }

      // ── Expenses ──────────────────────────────────────────────────────────
      // SEC-8 FIX: canViewRevenue is VIEW only — write requires owner
      match /expenses/{expenseId} {
        allow read: if isOwner(libraryId) || staffCan(libraryId, 'canViewRevenue');
        allow write: if isOwner(libraryId);
      }

      // ── Announcements ────────────────────────────────────────────────────
      // Enrolled students and staff can read all announcements
      match /announcements/{id} {
        allow read: if isAuth();
        allow update: if ownerOrStaffCan(libraryId, 'canManageStudents') ||
                         (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow create, delete: if ownerOrStaffCan(libraryId, 'canManageStudents');
      }

      // ── Holidays ─────────────────────────────────────────────────────────
      // Require auth to read — no public access to library schedule data
      match /holidays/{id} {
        allow read: if isAuth();
        allow write: if ownerOrStaffCan(libraryId, 'canManageSettings');
      }

      // ── Feedback ─────────────────────────────────────────────────────────
      // SEC-4 FIX: Students can only read their OWN feedback (cross-library PII leak)
      match /feedback/{id} {
        allow read: if isOwner(libraryId) ||
                       staffCan(libraryId, 'canManageStudents') ||
                       (isAuth() && (
                         resource.data.get('studentId', '') == uid() ||
                         resource.data.get('studentUserId', '') == uid() ||
                         resource.data.get('userId', '') == uid()
                       ));
        allow create: if isAuth();
        allow update, delete: if isOwner(libraryId) ||
                                 staffCan(libraryId, 'canManageStudents');
      }

      // ── Requests ─────────────────────────────────────────────────────────
      // SEC-5 FIX: Students can only read their OWN requests (cross-library PII leak)
      match /requests/{id} {
        allow read: if isOwner(libraryId) ||
                       staffCan(libraryId, 'canManageStudents') ||
                       (isAuth() && (
                         resource.data.get('studentId', '') == uid() ||
                         resource.data.get('studentUserId', '') == uid() ||
                         resource.data.get('userId', '') == uid()
                       ));
        allow create: if isAuth();
        allow update, delete: if isOwner(libraryId) ||
                                 staffCan(libraryId, 'canManageStudents') ||
                                 (isAuth() && (
                                   resource.data.get('studentId', '') == uid() ||
                                   resource.data.get('studentUserId', '') == uid() ||
                                   resource.data.get('userId', '') == uid()
                                 ) && resource.data.get('status', 'pending') == 'pending');
      }

      // ── Student & In-App Notifications ─────────────────────────────────────
      match /notifications/{id} {
        allow read: if isAuth();

        // Students can create notifications for themselves or targeted to admin (e.g. renewal triggers, feedback, seat change)
        // Owner/staff can create for anyone
        allow create: if ownerOrStaffCan(libraryId, 'canManageStudents') ||
                         (isAuth() && (
                           request.resource.data.get('targetUserId', '') == uid() ||
                           request.resource.data.get('studentUserId', '') == uid() ||
                           request.resource.data.get('userId', '') == uid() ||
                           request.resource.data.get('targetRole', '') == 'admin'
                         ));

        // Students can mark their own notifications read; staff/owner can update any
        allow update: if ownerOrStaffCan(libraryId, 'canManageStudents') ||
                         (isAuth() && (
                           resource.data.get('targetUserId', '') == uid() ||
                           resource.data.get('studentUserId', '') == uid() ||
                           resource.data.get('userId', '') == uid() ||
                           resource.data.get('targetRole', '') == 'all' ||
                           resource.data.get('targetRole', '') == 'student'
                         ) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']));

        allow delete: if isOwner(libraryId) ||
                         staffCan(libraryId, 'canManageStudents') ||
                         (isAuth() && (
                           resource.data.get('targetUserId', '') == uid() ||
                           resource.data.get('studentUserId', '') == uid() ||
                           resource.data.get('userId', '') == uid() ||
                           resource.data.get('targetRole', '') == 'student'
                         ));
      }

      // ── Admin Notifications ───────────────────────────────────────────────
      match /admin_notifications/{id} {
        allow create: if isAuth();
        allow read, update, delete: if isOwner(libraryId) || staffCan(libraryId, 'canManageStudents');
      }

      // ── Audit log — immutable ─────────────────────────────────────────────
      // SEC-6 FIX: Only owner/staff can write audit entries (prevent log pollution)
      match /audit_log/{id} {
        allow read: if isOwner(libraryId) || staffCan(libraryId, 'canViewRevenue') || staffCan(libraryId, 'canManageStudents');
        allow create: if ownerOrStaffCan(libraryId, 'canManageStudents');
        allow update, delete: if false; // NEVER modifiable
      }

      // ── Recycle bin — owner or active staff member ────────────────────────
      match /recycle_bin/{id} {
        allow read, write: if isOwner(libraryId) || isActiveStaff(libraryId);
      }

      // ── Waiting list ──────────────────────────────────────────────────────
      match /waiting_list/{id} {
        allow read: if isAuth() && (
          ownerOrStaffCan(libraryId, 'canManageStudents') ||
          resource.data.get('userId', '') == uid() ||
          resource.data.get('studentPhone', '') == request.auth.token.phone_number
        );
        allow create: if isAuth() && (
          ownerOrStaffCan(libraryId, 'canManageStudents') ||
          request.resource.data.get('userId', '') == uid()
        );
        allow update, delete: if ownerOrStaffCan(libraryId, 'canManageStudents');
      }

      // ── Staff management ──────────────────────────────────────────────────
      match /staff/{staffId} {
        allow read: if isOwner(libraryId) || isActiveStaff(libraryId) ||
                       (isAuth() && (staffId == uid() || (resource != null && resource.data.get('email', '').lower() == request.auth.token.email.lower())));
        allow create: if isOwner(libraryId) ||
                         (isAuth() && staffId == uid() && request.auth.token.email != null &&
                          request.resource.data.get('email', '').lower() == request.auth.token.email.lower());
        allow update: if isOwner(libraryId) ||
                         (isAuth() && staffId == uid() && request.auth.token.email != null &&
                          request.resource.data.get('email', '').lower() == request.auth.token.email.lower() &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'role', 'canManageSeats', 'canRecordPayments', 'canManageStudents',
                            'canDeleteStudents', 'canViewRevenue', 'canManageSettings', 'canManagePlans',
                            'canExportData', 'canManageRequests', 'canViewAuditLog'
                          ]));
        allow delete: if isOwner(libraryId) ||
                         (isAuth() && request.auth.token.email != null &&
                          resource.data.get('email', '').lower() == request.auth.token.email.lower());
      }

      // ── Settings ─────────────────────────────────────────────────────────
      // SEC-3 FIX: Require authentication to read settings (protects stamp URLs,
      // watermark images, custom terms, form config — not fully public data)
      match /settings/{id} {
        allow read: if isAuth();
        allow write: if isOwner(libraryId) || staffCan(libraryId, 'canManageSettings');
      }

      // ── Daily Backups & Chunks ────────────────────────────────────────────
      match /daily_backups/{backupId} {
        allow read, write: if isOwner(libraryId) || staffCan(libraryId, 'canManageSettings');

        match /chunks/{chunkId} {
          allow read, write: if isOwner(libraryId) || staffCan(libraryId, 'canManageSettings');
        }
      }
    }

    // ── Users collection (role persistence & FCM tokens) ────────────────────
    match /users/{userId} {
      // S7 FIX: Users can only read their own profile & FCM tokens; master admins can read for support
      allow read: if isAuth() && (uid() == userId || isMasterAdmin());

      // Prevent privilege escalation: only master admins can assign 'admin' role
      allow create: if isAuth() && (
        isMasterAdmin() ||
        (uid() == userId && request.resource.data.get('role', 'student') != 'admin')
      );

      // S7 & S10 FIX: Prevent self-escalation of roles and unauthorized edits
      allow update: if isAuth() && (
        isMasterAdmin() ||
        (uid() == userId && (
          // Role cannot be changed by the user themselves unless already matches
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
           request.resource.data.get('role', '') == resource.data.get('role', ''))
        ))
      );

      allow delete: if isAuth() && (uid() == userId || isMasterAdmin());

      match /login_history/{logId} {
        allow read, write: if isAuth() && (uid() == userId || isMasterAdmin());
      }
    }

    // ── Admin whitelist ──────────────────────────────────────────────────────
    // SEC-C1 FIX: Only master admins can manage the admin whitelist.
    // Previously ANY authenticated user could write — privilege escalation risk.
    match /admin_whitelist/{emailKey} {
      allow read: if isAuth();
      allow write: if isMasterAdmin();
    }

    // ── App config (public read, no write) ──────────────────────────────────
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Root recycle bin fallback ───────────────────────────────────────────
    match /recycle_bin/{docId} {
      allow read, write: if isMasterAdmin() ||
        (isAuth() && resource != null && isOwner(resource.data.get('libraryId', 'NONE'))) ||
        (isAuth() && request.resource != null && isOwner(request.resource.data.get('libraryId', 'NONE')));
    }

    // ── Collection Group queries ─────────────────────────────────────────────
    // SEC-2 FIX: Staff — only the staff member themselves OR their library owner
    // Prevents any authenticated user from reading all staff across all libraries
    match /{path=**}/staff/{staffDoc} {
      allow read: if isAuth() && (
        resource.data.get('userId', '') == uid() ||
        (resource.data.get('email', '') != '' && request.auth.token.email != null &&
         resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
        uid() == get(/databases/$(database)/documents/libraries/$(resource.data.get('libraryId', 'NONE'))).data.get('ownerId', '')
      );
    }

    // SEC-2 FIX: Students — only the student themselves OR their library owner/staff
    // Prevents Student A from using collectionGroup('students') to read Student B's data
    match /{path=**}/students/{studentDoc} {
      allow read: if isAuth() && (
        studentDoc == uid() ||
        resource.data.get('userId', '') == uid() ||
        resource.data.get('studentUserId', '') == uid() ||
        (resource.data.get('email', '') != '' && request.auth.token.email != null &&
         resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
        (request.auth.token.phone_number != null &&
         (resource.data.get('phone', '') == request.auth.token.phone_number ||
          ('+91' + resource.data.get('phone', '')) == request.auth.token.phone_number ||
          resource.data.get('phone', '') == ('+91' + request.auth.token.phone_number))) ||
        uid() == get(/databases/$(database)/documents/libraries/$(resource.data.get('libraryId', 'NONE'))).data.get('ownerId', '')
      );
    }
  }
}
