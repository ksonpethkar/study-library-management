rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return request.auth.token.email;
    }

    function isMasterAdmin() {
      return isAuth() && (
        email() in ['ksonpethkar@gmail.com', 'thecozycornersc@gmail.com'] ||
        (firestore.exists(/databases/(default)/documents/admin_whitelist/$(email())) &&
         firestore.get(/databases/(default)/documents/admin_whitelist/$(email())).data.isActive == true)
      );
    }

    function isOwner(libraryId) {
      return isAuth() && (
        isMasterAdmin() ||
        (firestore.exists(/databases/(default)/documents/libraries/$(libraryId)) &&
         firestore.get(/databases/(default)/documents/libraries/$(libraryId)).data.ownerId == uid())
      );
    }

    function isStaff(libraryId) {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/libraries/$(libraryId)/staff/$(uid())) &&
        firestore.get(/databases/(default)/documents/libraries/$(libraryId)/staff/$(uid())).data.isActive == true;
    }

    function isOwnerOrStaff(libraryId) {
      return isOwner(libraryId) || isStaff(libraryId);
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isUnder2MB() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    // ── Library logos ────────────────────────────────────────────────────────
    // Only library owner or staff can upload/change logo; public can read
    match /libraries/{libraryId}/logo/{fileName} {
      allow read: if true;   // Public — shown in app UI & registration
      allow write: if isOwnerOrStaff(libraryId) && isImage() && isUnder5MB();
    }

    // ── Admin official stamps ─────────────────────────────────────────────────
    // Only owner or staff can write official stamps
    match /libraries/{libraryId}/stamps/{fileName} {
      allow read: if isAuth();
      allow write: if isOwnerOrStaff(libraryId) && isImage() && isUnder2MB();
    }

    // ── Receipt templates & headers ──────────────────────────────────────────
    match /libraries/{libraryId}/receipt_template/{fileName} {
      allow read: if isAuth();
      allow write: if isOwnerOrStaff(libraryId) && isImage() && isUnder2MB();
    }

    // ── Student photos ────────────────────────────────────────────────────────
    // Only the student themselves or library staff/owner can read/write
    match /libraries/{libraryId}/students/{studentId}/{fileName} {
      allow read: if isAuth() && (uid() == studentId || isOwnerOrStaff(libraryId));
      allow write: if isAuth() && (uid() == studentId || isOwnerOrStaff(libraryId)) && isImage() && isUnder5MB();
    }

    // ── ID card assets ────────────────────────────────────────────────────────
    match /libraries/{libraryId}/id_cards/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isOwnerOrStaff(libraryId) && isUnder2MB();
    }

    // ── Bulk import files (CSV) ───────────────────────────────────────────────
    match /libraries/{libraryId}/imports/{fileName} {
      allow read: if isOwnerOrStaff(libraryId);
      allow write: if isOwnerOrStaff(libraryId) && request.resource.size < 10 * 1024 * 1024;
    }

    // ── General library assets (QR codes, exports, backups) ──────────────────
    // SEC-4 FIX: Scoped to owner or active staff only (previously open to any auth user)
    match /libraries/{libraryId}/{allPaths=**} {
      allow read: if isOwnerOrStaff(libraryId);
      allow write: if isOwnerOrStaff(libraryId) && isUnder5MB();
    }

    // ── Public app assets (if any) ────────────────────────────────────────────
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; // No client writes to public/ — deploy only
    }
  }
}
